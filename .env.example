# Copy to .env.local for local work, and add the same values in Vercel > Project > Settings > Environment Variables.
# Leave the Supabase lines empty to run in demo mode (sample bookings, dashboard password "demo").

# Owner dashboard (Standard and Premium)
ADMIN_PASSWORD=
SESSION_SECRET=            # any long random string

# Database (client's own Supabase project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY= # server only, never expose to the browser

# Email (Resend). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Aurora Colour Studio <bookings@example.co.uk>"

# SMS (Twilio, Standard and Premium)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=               # e.g. +447... or an approved alphanumeric sender ID

# Deposits (Stripe, Premium). Use the client's own account.
STRIPE_SECRET_KEY=

# Reminders (Premium). Vercel sends this automatically to cron routes once set.
CRON_SECRET=
